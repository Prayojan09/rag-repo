APP_NAME=Document Intelligence API
ENVIRONMENT=development
LOG_LEVEL=INFO
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Comma-separated browser origins for direct frontend-to-API deployments.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
QDRANT_URL=http://localhost:6333
# QDRANT_TIMEOUT_SECONDS controls vector database request timeouts independently of health checks.
QDRANT_TIMEOUT_SECONDS=30
# QDRANT_API_KEY=
REQUEST_TIMEOUT_SECONDS=3.0
UPLOAD_DIR=data/uploads
MAX_UPLOAD_BYTES=104857600
OCR_LANGUAGE=eng
OCR_DPI=200
OCR_FALLBACK_PAGE_SEGMENTATION_MODE=6
HANDWRITING_OCR_MODEL=microsoft/trocr-small-handwritten
HANDWRITING_OCR_MIN_CONFIDENCE=75
HANDWRITING_OCR_BATCH_SIZE=16
HANDWRITING_OCR_CPU_THREADS=4
# Optional full path to tesseract.exe if it is installed outside the standard location or PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=150
# Ingestion normalization and quality diagnostics.
INGESTION_HEADING_MAX_CHARS=140
INGESTION_HEADER_REPEAT_FRACTION=0.5
INGESTION_REPORT_DIR=data/reports
INGESTION_TOKEN_ENCODING=cl100k_base
# Optional JSON list; extend for the metadata labels used by your documents.
# INGESTION_METADATA_LABELS=["Duration","Level","Price","Date","Location","Author","Version","Format","Provider","Certification","Status","Owner","Category"]
INGESTION_TINY_CHUNK_TOKENS=20
INGESTION_TINY_CHUNK_FRACTION=0.33
INGESTION_LOW_TEXT_CHARS_PER_PAGE=100
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_REVISION=main
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=64
QDRANT_COLLECTION=rag_chunks
SEARCH_DEFAULT_TOP_K=10
SEARCH_MAX_TOP_K=50
SEARCH_CANDIDATE_MULTIPLIER=4
SEARCH_CANDIDATE_MAX=200
BM25_MAX_CHUNKS=50000
RRF_CONSTANT=60
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_MODEL_REVISION=main
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=32
RERANKER_CANDIDATE_K=40
LLM_PROVIDER=disabled
LLM_BASE_URL=https://api.openai.com/v1
# Set these locally to enable POST /api/v1/chat. Never commit a real key.
# LLM_API_KEY=
# LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=2048
DOCUMENT_STRUCTURING_ENABLED=true
DOCUMENT_STRUCTURING_MAX_CHARS=40000
DOCUMENT_STRUCTURING_MAX_TOKENS=8192
CHAT_CONTEXT_K=8
# Optional in development; required outside development. Protects /api/v1 routes.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# API_ACCESS_TOKEN=
# Optional JSON object mapping tenant IDs to distinct 32+ character tokens.
# API_TENANT_TOKENS={"team-a":"<token-a>","team-b":"<token-b>"}
# API_TENANT_TOKENS=

# Optional Google OAuth login. Create a Web application OAuth client in Google Cloud.
# Authorized redirect URI: http://localhost:8000/api/v1/auth/google/callback
# Set all three values together; do not commit real credentials.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
AUTH_FRONTEND_URL=http://localhost:5173
AUTH_SESSION_COOKIE_NAME=rag_session
AUTH_SESSION_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=43200
GOOGLE_OAUTH_STATE_TTL_SECONDS=600
GOOGLE_TOKEN_CLOCK_SKEW_SECONDS=60
# Optional: map this one verified Google account to the legacy default tenant.
# GOOGLE_DEFAULT_TENANT_EMAIL=
