APP_NAME=Document Intelligence API
ENVIRONMENT=production
LOG_LEVEL=INFO
ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com

# Use managed PostgreSQL and Qdrant services with TLS and private networking.
DATABASE_URL=postgresql+psycopg://rag:REPLACE_WITH_LONG_RANDOM_PASSWORD@db.example.com:5432/rag?sslmode=require
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
QDRANT_URL=https://your-cluster.example.qdrant.io
QDRANT_API_KEY=REPLACE_WITH_QDRANT_API_KEY
QDRANT_COLLECTION=rag_chunks
QDRANT_TIMEOUT_SECONDS=30

# Google OAuth web client. Register this exact callback URL in Google Cloud.
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_WEB_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_WEB_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://api.example.com/api/v1/auth/google/callback
AUTH_FRONTEND_URL=https://app.example.com
AUTH_SESSION_COOKIE_NAME=rag_session
AUTH_SESSION_COOKIE_SECURE=true
AUTH_SESSION_TTL_SECONDS=43200
GOOGLE_OAUTH_STATE_TTL_SECONDS=600
# Optional: attach this verified Google account to existing legacy default-tenant data.
# GOOGLE_DEFAULT_TENANT_EMAIL=

# Optional for non-browser service integrations. Omit for Google-only interactive login.
# API_ACCESS_TOKEN=REPLACE_WITH_A_LONG_RANDOM_API_TOKEN

UPLOAD_DIR=/srv/backend/data/uploads
MAX_UPLOAD_BYTES=104857600
OCR_LANGUAGE=eng
OCR_DPI=200
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=150

# Pin each value to a real immutable Hugging Face commit before deployment.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_REVISION=REPLACE_WITH_IMMUTABLE_COMMIT
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=64
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_MODEL_REVISION=REPLACE_WITH_IMMUTABLE_COMMIT
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=32

# Configure an OpenAI-compatible provider to enable chat.
LLM_PROVIDER=disabled
# LLM_BASE_URL=https://provider.example/v1
# LLM_MODEL=provider/model-id
# LLM_API_KEY=REPLACE_WITH_PROVIDER_SECRET
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
DOCUMENT_STRUCTURING_ENABLED=false
